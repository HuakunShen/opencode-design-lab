{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "design_models": {
      "minItems": 2,
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string",
            "description": "Model identifier (e.g. 'opencode/kimi-k2.6')"
          },
          {
            "type": "object",
            "properties": {
              "model": {
                "type": "string",
                "description": "Model identifier (e.g. 'opencode/kimi-k2.6')"
              },
              "variant": {
                "default": "max",
                "description": "Reasoning effort variant",
                "type": "string",
                "enum": [
                  "low",
                  "medium",
                  "high",
                  "max"
                ]
              }
            },
            "required": [
              "model",
              "variant"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "review_models": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string",
            "description": "Model identifier (e.g. 'opencode/kimi-k2.6')"
          },
          {
            "type": "object",
            "properties": {
              "model": {
                "type": "string",
                "description": "Model identifier (e.g. 'opencode/kimi-k2.6')"
              },
              "variant": {
                "default": "max",
                "description": "Reasoning effort variant",
                "type": "string",
                "enum": [
                  "low",
                  "medium",
                  "high",
                  "max"
                ]
              }
            },
            "required": [
              "model",
              "variant"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "base_output_dir": {
      "default": ".design-lab",
      "type": "string"
    },
    "design_agent_temperature": {
      "default": 0.7,
      "type": "number",
      "minimum": 0,
      "maximum": 2
    },
    "review_agent_temperature": {
      "default": 0.1,
      "type": "number",
      "minimum": 0,
      "maximum": 2
    },
    "topic_generator_model": {
      "type": "string"
    }
  },
  "required": [
    "design_models",
    "base_output_dir",
    "design_agent_temperature",
    "review_agent_temperature"
  ],
  "additionalProperties": false
}