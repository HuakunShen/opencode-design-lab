{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "models": {
      "minItems": 2,
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string",
            "description": "Model identifier (e.g. 'opencode/kimi-k2.6')"
          },
          {
            "type": "object",
            "properties": {
              "model": {
                "type": "string",
                "description": "Model identifier (e.g. 'opencode/kimi-k2.6')"
              },
              "variant": {
                "description": "Optional model variant. Use null to omit variant for this model.",
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "model"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "default_variant": {
      "default": "max",
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "base_output_dir": {
      "default": ".design-lab",
      "type": "string"
    },
    "design_agent_temperature": {
      "default": 0.7,
      "type": "number",
      "minimum": 0,
      "maximum": 2
    },
    "review_agent_temperature": {
      "default": 0.1,
      "type": "number",
      "minimum": 0,
      "maximum": 2
    },
    "topic_generator_model": {
      "type": "string"
    }
  },
  "required": [
    "models",
    "default_variant",
    "base_output_dir",
    "design_agent_temperature",
    "review_agent_temperature"
  ],
  "additionalProperties": false
}